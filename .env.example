# =============================================================================
# PR-Review-Agent environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env.example` is committed, so it must contain placeholders only.
# =============================================================================

# Required — GitHub Personal Access Token with `repo` + `pull_requests` scope.
# Create one at https://github.com/settings/tokens
#   - Fine-grained token: Pull requests read/write, Contents read, Metadata read.
#   - Classic token: repo.
GITHUB_TOKEN=ghp_your_token_here

# Optional — only used by the LLM review pass below. The deterministic pipeline
# (CLI, CI, VS Code panel, dashboard) runs with no Anthropic key at all.
# Your Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional — the LLM review pass. OFF by default. When enabled (and a key is
# present) it runs AFTER the deterministic agents and adds one section: logic
# problems regex cannot see, plus a false-positive verdict on the rule engine's
# own findings. Advisory only — the APPROVE / REQUEST CHANGES decision stays
# deterministic, and any failure is swallowed so the review always completes.
PR_AGENT_LLM=0
# Optional — override the model used by that pass. Default: claude-opus-5.
# PR_AGENT_LLM_MODEL=claude-opus-5

# Optional — repository owner/name. Auto-detected from the git remote when omitted.
GITHUB_OWNER=
GITHUB_REPO=

# Optional — MCP server port. The server runs over stdio by default; this is only
# used if you run the HTTP bridge. Default 3000.
MCP_SERVER_PORT=3000

# Optional — local Ollama model used by the VS Code chat agents.
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# Optional — external security scanners (Semgrep + Gitleaks + Trivy).
# When a review runs, the Security agent AUTOMATICALLY runs these in Docker and
# folds their findings into its section. Requires Docker Desktop to be *running*.
# If Docker isn't available it silently falls back to the built-in regex engine.
#   - Set to 0/false/off to disable auto-scanning entirely.
#   - Leave unset (default) to auto-scan whenever Docker is up.
PR_AGENT_AUTO_SCAN=1
# Optional — where scanner SARIF is read from / written to. Default: <cwd>/sarif.
# PR_AGENT_SARIF_DIR=
