# Web dashboard configuration — placeholder values only, never commit real tokens.
# The web server auto-loads `.env` from web/server/ and from the repo root.

# Port the HTTP API listens on. The client defaults to http://localhost:${WEB_SERVER_PORT}.
WEB_SERVER_PORT=4000

# Master key used by secureStore.ts to encrypt persisted tokens (AES-256-GCM).
# Any 32+ character random string. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_SECRET_KEY=

# The same variables the MCP server loads — used as an initial default when
# no encrypted settings.json is present yet.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
ANTHROPIC_API_KEY=
OLLAMA_MODEL=
OLLAMA_URL=
