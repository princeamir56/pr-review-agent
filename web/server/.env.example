# Web dashboard configuration — placeholder values only, never commit real tokens.
# The web server auto-loads the first `.env` it finds: web/server/.env, then the
# pr-review-agent repo root. Both are resolved relative to pr-review-agent's own
# folder, not the directory the server was launched from — so this works the same
# whether you run `npm run dev` here or `npm --prefix server run start` from web/.
# Real environment variables always win over values in the file.

# Port the HTTP API listens on. The client defaults to http://localhost:${WEB_SERVER_PORT}.
WEB_SERVER_PORT=4000

# REQUIRED. Master key used by secureStore.ts to encrypt persisted tokens
# (AES-256-GCM). The server refuses to start without it: there is no fallback,
# because a default key would mean secrets are encrypted with a value published
# in this repo. Minimum 16 characters; 32+ recommended. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this out of version control and back it up — losing it makes any
# already-encrypted .web-settings.json values unreadable.
WEB_SECRET_KEY=

# The same variables the MCP server loads — used as an initial default when
# no encrypted settings.json is present yet.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
ANTHROPIC_API_KEY=
OLLAMA_MODEL=
OLLAMA_URL=
